          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "失败"
          }
        },
        "security": [
          {
            "adminToken": []
          }
        ]
      }
    },
