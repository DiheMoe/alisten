{
  "components": {
    "schemas": {
      "AdminUpdateRoomRequest": {
        "additionalProperties": false,
        "properties": {
          "homepage": {
            "format": "iri",
            "maxLength": 200,
            "type": "string",
            "x-maxBytes": 600,
            "x-url": true
          },
          "limit": {
            "description": "一页最多返回的条数",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "note": {
            "pattern": "^[^`]*$",
            "type": "string"
          },
          "slug": {
            "pattern": "^[a-z0-9-]{0,32}$",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CreateMemberRequest": {
        "additionalProperties": false,
        "type": "object"
      },
      "CreateMemberResponse": {
        "additionalProperties": false,
        "properties": {
          "member": {
            "$ref": "#/components/schemas/Member"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "member",
          "token"
        ],
        "type": "object"
      },
      "CreateRoomRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateRoomResponse": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "Empty": {
        "additionalProperties": false,
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "INVALID_ARGUMENT",
          "NOT_FOUND",
          "CLIENT_OUTDATED"
        ],
        "type": "string",
        "x-httpStatus": {
          "INVALID_ARGUMENT": 400,
          "NOT_FOUND": 404
        }
      },
      "ErrorInfo": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Member": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "QueueAddRequest": {
        "additionalProperties": false,
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "requester": {},
              "track": {}
            },
            "required": [
              "track"
            ]
          },
          {
            "additionalProperties": false,
            "properties": {
              "keyword": {},
              "requester": {},
              "source": {}
            },
            "required": [
              "source",
              "keyword"
            ]
          }
        ],
        "properties": {
          "keyword": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "requester": {
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "track": {
            "$ref": "#/components/schemas/Track"
          }
        },
        "type": "object"
      },
      "Room": {
        "additionalProperties": false,
        "description": "房间",
        "properties": {
          "gain": {
            "type": "number"
          },
          "id": {
            "type": "string"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "type": "array"
          },
          "open": {
            "type": "boolean"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "gain",
          "id",
          "members",
          "open",
          "slug"
        ],
        "type": "object"
      },
      "SearchTracksResponse": {
        "additionalProperties": false,
        "properties": {
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "total"
        ],
        "type": "object"
      },
      "Source": {
        "enum": [
          "netease",
          "qq",
          "link"
        ],
        "type": "string"
      },
      "Track": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "link"
                }
              },
              "required": [
                "source"
              ]
            },
            "then": {
              "properties": {
                "id": {
                  "pattern": "^https?://\\S+$",
                  "x-maxBytes": 2048
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "netease"
                }
              },
              "required": [
                "source"
              ]
            },
            "then": {
              "properties": {
                "id": {
                  "pattern": "^[0-9]+$"
                }
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "required": [
          "id",
          "source"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "adminToken": {
        "scheme": "bearer",
        "type": "http"
      },
      "memberToken": {
        "scheme": "bearer",
        "type": "http"
      },
      "ticket": {
        "description": "进房票据或常驻房间的 API Key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Sample",
    "version": "362d144af81ba8bf"
  },
  "openapi": "3.1.0",
  "paths": {
