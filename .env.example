# Alisten 相关
ALISTEN_HOST=127.0.0.1                          # 绑定的 ip
ALISTEN_PORT=9876                               # 监听的端口
ALISTEN_ALLOWED_ORIGINS=""                      # 逗号分隔的 Origin 允许列表，留空时仅允许 ALISTEN_PUBLIC_URL
ALISTEN_LOG_LEVEL=info                          # 日志等级, 可选值为 debug、info、warn、error
ALISTEN_WORKER_TMP_SIZE="1g"                    # Worker 临时文件大小
ALISTEN_ADMIN_TOKEN=""                          # 进入管理后台需要的凭证, 留空则禁用后台

# 公网访问相关
ACME_EMAIL=""                                   # Let's Encrypt 邮箱
ALISTEN_DOMAIN=""                               # Alisten 域名
STORAGE_DOMAIN=""                               # 对象存储服务域名
ALISTEN_PUBLIC_URL="https://${ALISTEN_DOMAIN}"  # 公网访问 URL

# 数据库相关
DATABASE_HOST=postgres                          # 数据库主机
DATABASE_PORT=5432                              # 数据库端口
DATABASE_USERNAME=alisten                       # 数据库用户名
DATABASE_PASSWORD=""                            # 数据库密码
DATABASE_NAME=alisten                           # 数据库名称
DATABASE_SSLMODE=prefer                         # SSL 模式

# redis 相关
REDIS_HOST=redis                                # redis 主机
REDIS_PORT=6379                                 # redis 端口
REDIS_PASSWORD=""                               # redis 密码
REDIS_DB=0                                      # redis 数据库

# 对象存储相关
STORAGE_ENDPOINT_URL=http://rustfs:9000         # AWS S3 兼容的对象存储服务端点
STORAGE_REGION=us-east-1                        # 区域
STORAGE_BUCKET_NAME=alisten                     # 存储桶名称
STORAGE_ACCESS_KEY_ID=""                        # 访问密钥 ID
STORAGE_SECRET_ACCESS_KEY=""                    # 秘密访问密钥
STORAGE_PUBLIC_URL=""                           # AWS S3 公开访问地址

# 可选
OTEL_EXPORTER_OTLP_ENDPOINT=""                  # OTLP/HTTP 地址
