随机播放：切换到随机模式之后，下一首从等待队列中按本次处理的随机数选出。
-- 01 --
> restore persistent
-- 02 --
> 0s mode m1 random
persist mode=random entrySeq=0 current=- pending=- waiting=[]
emit 1.1 mode random
reply q02 done
-- 03 --
> 0s enqueue m1 netease:a
persist mode=random entrySeq=1 current=- pending=#1(netease:a) waiting=[]
emit 1.2 activity added m1 #1(netease:a)
emit 1.3 queue pending=#1(netease:a) waiting=[]
reply q03 enqueued #1(netease:a)
prepare netease:a
-- 04 --
> 0s enqueue m1 netease:b
persist mode=random entrySeq=2 current=- pending=#1(netease:a) waiting=[#2(netease:b,round=1)]
emit 1.4 activity added m1 #2(netease:b,round=1)
emit 1.5 queue pending=#1(netease:a) waiting=[#2(netease:b,round=1)]
reply q04 enqueued #2(netease:b,round=1)
prepare netease:b
-- 05 --
> 0s enqueue m1 netease:c
persist mode=random entrySeq=3 current=- pending=#1(netease:a) waiting=[#2(netease:b,round=1) #3(netease:c,round=2)]
emit 1.6 activity added m1 #3(netease:c,round=2)
emit 1.7 queue pending=#1(netease:a) waiting=[#2(netease:b,round=1) #3(netease:c,round=2)]
reply q05 enqueued #3(netease:c,round=2)
prepare netease:c
-- 06 --
> 0s enqueue m1 netease:d
persist mode=random entrySeq=4 current=- pending=#1(netease:a) waiting=[#2(netease:b,round=1) #3(netease:c,round=2) #4(netease:d,round=3)]
emit 1.8 activity added m1 #4(netease:d,round=3)
emit 1.9 queue pending=#1(netease:a) waiting=[#2(netease:b,round=1) #3(netease:c,round=2) #4(netease:d,round=3)]
reply q06 enqueued #4(netease:d,round=3)
prepare netease:d
-- 07 --
> 1s prepared netease:a 1m
persist mode=random entrySeq=4 current=#1(netease:a,ready)@1.2s pending=- waiting=[#2(netease:b,round=1) #3(netease:c,round=2) #4(netease:d,round=3)]
emit 1.10 queue pending=- waiting=[#2(netease:b,round=1) #3(netease:c,round=2) #4(netease:d,round=3)]
emit 1.11 playback #1(netease:a,ready)@1.2s
schedule 1 1m1.2s
-- 08 --
> 1s prepared netease:b 1m
persist mode=random entrySeq=4 current=#1(netease:a,ready)@1.2s pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,round=2) #4(netease:d,round=3)]
emit 1.12 queue pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,round=2) #4(netease:d,round=3)]
-- 09 --
> 1s prepared netease:c 1m
persist mode=random entrySeq=4 current=#1(netease:a,ready)@1.2s pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,ready,round=2) #4(netease:d,round=3)]
emit 1.13 queue pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,ready,round=2) #4(netease:d,round=3)]
-- 10 --
> 1s prepared netease:d 1m
persist mode=random entrySeq=4 current=#1(netease:a,ready)@1.2s pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,ready,round=2) #4(netease:d,ready,round=3)]
emit 1.14 queue pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,ready,round=2) #4(netease:d,ready,round=3)]
-- 11 --
> 1m1.2s timer 1
persist mode=random entrySeq=4 current=#3(netease:c,ready,round=2)@1m1.4s pending=- waiting=[#2(netease:b,ready,round=1) #4(netease:d,ready,round=3)]
record #1(netease:a,ready) 1.2s-1m1.2s
emit 1.15 queue pending=- waiting=[#2(netease:b,ready,round=1) #4(netease:d,ready,round=3)]
emit 1.16 playback #3(netease:c,ready,round=2)@1m1.4s
schedule 2 2m1.4s
