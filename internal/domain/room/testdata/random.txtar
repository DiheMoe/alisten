随机播放：有歌在播时，下一首提前从等待队列里随机抽好，切歌时放抽好的那首。
-- 01 --
> restore persistent
-- 02 --
> 0s mode m1 random
persist mode=random entrySeq=0 current=- pending=- waiting=[]
emit 1.1 mode random
reply q02 done
-- 03 --
> 0s enqueue m1 netease:a
persist mode=random entrySeq=1 current=- pending=#1(netease:a) waiting=[]
emit 1.2 activity added m1 #1(netease:a)
emit 1.3 queue pending=#1(netease:a) waiting=[] next=-
reply q03 enqueued #1(netease:a)
prepare netease:a
-- 04 --
> 0s enqueue m1 netease:b
persist mode=random entrySeq=2 current=- pending=#1(netease:a) waiting=[#2(netease:b,round=1)]
emit 1.4 activity added m1 #2(netease:b,round=1)
emit 1.5 queue pending=#1(netease:a) waiting=[#2(netease:b,round=1)] next=-
reply q04 enqueued #2(netease:b,round=1)
prepare netease:b
-- 05 --
> 0s enqueue m1 netease:c
persist mode=random entrySeq=3 current=- pending=#1(netease:a) waiting=[#2(netease:b,round=1) #3(netease:c,round=2)]
emit 1.6 activity added m1 #3(netease:c,round=2)
emit 1.7 queue pending=#1(netease:a) waiting=[#2(netease:b,round=1) #3(netease:c,round=2)] next=-
reply q05 enqueued #3(netease:c,round=2)
prepare netease:c
-- 06 --
> 0s enqueue m1 netease:d
persist mode=random entrySeq=4 current=- pending=#1(netease:a) waiting=[#2(netease:b,round=1) #3(netease:c,round=2) #4(netease:d,round=3)]
emit 1.8 activity added m1 #4(netease:d,round=3)
emit 1.9 queue pending=#1(netease:a) waiting=[#2(netease:b,round=1) #3(netease:c,round=2) #4(netease:d,round=3)] next=-
reply q06 enqueued #4(netease:d,round=3)
prepare netease:d
-- 07 --
> 1s prepared netease:a 1m
persist mode=random entrySeq=4 current=#1(netease:a,ready)@2.5s pending=- waiting=[#2(netease:b,round=1) #3(netease:c,round=2) #4(netease:d,round=3)]
emit 1.10 playback #1(netease:a,ready)@2.5s
emit 1.11 queue pending=- waiting=[#2(netease:b,round=1) #3(netease:c,round=2) #4(netease:d,round=3)] next=-
schedule 1 1m2.5s
-- 08 --
> 1s prepared netease:b 1m
persist mode=random entrySeq=4 current=#1(netease:a,ready)@2.5s pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,round=2) #4(netease:d,round=3)]
emit 1.12 queue pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,round=2) #4(netease:d,round=3)] next=#2
-- 09 --
> 1s prepared netease:c 1m
persist mode=random entrySeq=4 current=#1(netease:a,ready)@2.5s pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,ready,round=2) #4(netease:d,round=3)]
emit 1.13 queue pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,ready,round=2) #4(netease:d,round=3)] next=#2
-- 10 --
> 1s prepared netease:d 1m
persist mode=random entrySeq=4 current=#1(netease:a,ready)@2.5s pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,ready,round=2) #4(netease:d,ready,round=3)]
emit 1.14 queue pending=- waiting=[#2(netease:b,ready,round=1) #3(netease:c,ready,round=2) #4(netease:d,ready,round=3)] next=#2
-- 11 --
> 1m1.2s timer 1
persist mode=random entrySeq=4 current=#2(netease:b,ready,round=1)@1m2.7s pending=- waiting=[#3(netease:c,ready,round=2) #4(netease:d,ready,round=3)]
record #1(netease:a,ready) 2.5s-1m2.5s
emit 1.15 playback #2(netease:b,ready,round=1)@1m2.7s
emit 1.16 queue pending=- waiting=[#3(netease:c,ready,round=2) #4(netease:d,ready,round=3)] next=#3
schedule 2 2m2.7s
