播放模式与等待队列的顺序：顺序播放和随机播放按点赞数和入队顺序排列，轮流播放在点赞数相同时先比轮次。任何模式下入队都会定下轮次，切换模式时按新模式重排并广播。
-- 01 --
> restore persistent
-- 02 --
> 0s enqueue m1 netease:a1
persist mode=sequential entrySeq=1 current=- pending=#1(netease:a1) waiting=[]
emit 1.1 activity added m1 #1(netease:a1)
emit 1.2 queue pending=#1(netease:a1) waiting=[]
reply q02 enqueued #1(netease:a1)
prepare netease:a1
-- 03 --
> 0s prepared netease:a1 1m
persist mode=sequential entrySeq=1 current=#1(netease:a1,ready)@200ms pending=- waiting=[]
emit 1.3 queue pending=- waiting=[]
emit 1.4 playback #1(netease:a1,ready)@200ms
schedule 1 1m0.2s
-- 04 --
> 1s enqueue m1 netease:a2
persist mode=sequential entrySeq=2 current=#1(netease:a1,ready)@200ms pending=- waiting=[#2(netease:a2,round=1)]
emit 1.5 activity added m1 #2(netease:a2,round=1)
emit 1.6 queue pending=- waiting=[#2(netease:a2,round=1)]
reply q04 enqueued #2(netease:a2,round=1)
prepare netease:a2
-- 05 --
> 1s enqueue m1 netease:a3
persist mode=sequential entrySeq=3 current=#1(netease:a1,ready)@200ms pending=- waiting=[#2(netease:a2,round=1) #3(netease:a3,round=2)]
emit 1.7 activity added m1 #3(netease:a3,round=2)
emit 1.8 queue pending=- waiting=[#2(netease:a2,round=1) #3(netease:a3,round=2)]
reply q05 enqueued #3(netease:a3,round=2)
prepare netease:a3
-- 06 --
> 2s enqueue m2 netease:b1
persist mode=sequential entrySeq=4 current=#1(netease:a1,ready)@200ms pending=- waiting=[#2(netease:a2,round=1) #3(netease:a3,round=2) #4(netease:b1)]
emit 1.9 activity added m2 #4(netease:b1)
emit 1.10 queue pending=- waiting=[#2(netease:a2,round=1) #3(netease:a3,round=2) #4(netease:b1)]
reply q06 enqueued #4(netease:b1)
prepare netease:b1
-- 07 --
> 3s mode m2 rotation
persist mode=rotation entrySeq=4 current=#1(netease:a1,ready)@200ms pending=- waiting=[#4(netease:b1) #2(netease:a2,round=1) #3(netease:a3,round=2)]
emit 1.11 mode rotation
emit 1.12 queue pending=- waiting=[#4(netease:b1) #2(netease:a2,round=1) #3(netease:a3,round=2)]
reply q07 done
-- 08 --
> 4s mode m1 random
persist mode=random entrySeq=4 current=#1(netease:a1,ready)@200ms pending=- waiting=[#2(netease:a2,round=1) #3(netease:a3,round=2) #4(netease:b1)]
emit 1.13 mode random
emit 1.14 queue pending=- waiting=[#2(netease:a2,round=1) #3(netease:a3,round=2) #4(netease:b1)]
reply q08 done
-- 09 --
> 5s mode m1 sequential
persist mode=sequential entrySeq=4 current=#1(netease:a1,ready)@200ms pending=- waiting=[#2(netease:a2,round=1) #3(netease:a3,round=2) #4(netease:b1)]
emit 1.15 mode sequential
reply q09 done
