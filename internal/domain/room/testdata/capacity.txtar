emit 1.6 members [s1=m1 s2=m2 s4=m1 s5=m1 s6=m1 s3=m3]
-- 12 --
> 4s rejoin s7 m1
emit 1.7 members [s1=m1 s2=m2 s4=m1 s5=m1 s6=m1 s3=m3 s7=m1]
-- 13 --
