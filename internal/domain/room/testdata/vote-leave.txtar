投票门槛随离开重算：4 个人时 1 票不够。同一成员关掉一个连接，人数不变。再有一个人离开，3 个人的门槛是 1，已有的 1 票就切歌，这次切歌的动态里没有成员。
-- 01 --
> restore persistent
-- 02 --
> 0s join s1 m1
emit 1.1 members [s1=m1]
reply q02 done
-- 03 --
> 0s join s2 m2
emit 1.2 members [s1=m1 s2=m2]
reply q03 done
-- 04 --
> 0s join s3 m3
emit 1.3 members [s1=m1 s2=m2 s3=m3]
reply q04 done
-- 05 --
> 0s join s4 m4
emit 1.4 members [s1=m1 s2=m2 s3=m3 s4=m4]
reply q05 done
-- 06 --
> 0s join s5 m1
emit 1.5 members [s1=m1 s2=m2 s3=m3 s4=m4 s5=m1]
reply q06 done
-- 07 --
> 1s enqueue m1 netease:a
persist mode=sequential entrySeq=1 current=- pending=#1(netease:a) waiting=[]
emit 1.6 activity added m1 #1(netease:a)
emit 1.7 queue pending=#1(netease:a) waiting=[] next=-
reply q07 enqueued #1(netease:a)
prepare netease:a
-- 08 --
> 1s prepared netease:a 3m
persist mode=sequential entrySeq=1 current=#1(netease:a,ready)@2.5s pending=- waiting=[]
listen [m1 m2 m3 m4] #1(netease:a,ready)@2.5s
emit 1.8 playback #1(netease:a,ready)@2.5s
emit 1.9 queue pending=- waiting=[] next=-
schedule 1 3m2.5s
-- 09 --
> 2s enqueue m2 netease:b
persist mode=sequential entrySeq=2 current=#1(netease:a,ready)@2.5s pending=- waiting=[#2(netease:b)]
emit 1.10 activity added m2 #2(netease:b)
emit 1.11 queue pending=- waiting=[#2(netease:b)] next=-
reply q09 enqueued #2(netease:b)
prepare netease:b
-- 10 --
> 2s prepared netease:b 3m
persist mode=sequential entrySeq=2 current=#1(netease:a,ready)@2.5s pending=- waiting=[#2(netease:b,ready)]
emit 1.12 queue pending=- waiting=[#2(netease:b,ready)] next=#2
-- 11 --
> 10s vote m1
emit 1.13 activity voted m1 #1(netease:a,ready) 1/2
reply q11 voted 1/2
-- 12 --
> 11s leave s5
emit 1.14 members [s1=m1 s2=m2 s3=m3 s4=m4]
-- 13 --
> 12s leave s3
persist mode=sequential entrySeq=2 current=#2(netease:b,ready)@13.5s pending=- waiting=[]
record #1(netease:a,ready) 2.5s-12s
listen [m1 m2 m4] #2(netease:b,ready)@13.5s
emit 1.15 activity skipped - #1(netease:a,ready) 1/1
emit 1.16 members [s1=m1 s2=m2 s4=m4]
emit 1.17 playback #2(netease:b,ready)@13.5s
emit 1.18 queue pending=- waiting=[] next=-
schedule 2 3m13.5s
recommend 3
