听歌记录：开播时记给所有在线成员，同一成员的几个会话只记一次。没有在播的歌时进入不记。中途进入的成员只记自己。
同一成员的第二台设备上线不记。断线重连时新会话先于旧会话的离开到达，也不记。离开之后再进入，按同一个开播时间再记一次。
-- 01 --
> restore persistent
-- 02 --
> 0s join s1 m1
emit 1.1 members [s1=m1]
-- 03 --
> 0s join s2 m1
emit 1.2 members [s1=m1 s2=m1]
-- 04 --
> 1s enqueue m1 netease:a
persist mode=sequential entrySeq=1 current=- pending=#1(netease:a) waiting=[]
emit 1.3 activity added m1 #1(netease:a)
emit 1.4 queue pending=#1(netease:a) waiting=[]
reply q04 enqueued #1(netease:a)
prepare netease:a
-- 05 --
> 2s enqueue m2 netease:b
persist mode=sequential entrySeq=2 current=- pending=#1(netease:a) waiting=[#2(netease:b)]
emit 1.5 activity added m2 #2(netease:b)
emit 1.6 queue pending=#1(netease:a) waiting=[#2(netease:b)]
reply q05 enqueued #2(netease:b)
prepare netease:b
-- 06 --
> 3s prepared netease:b 1m
persist mode=sequential entrySeq=2 current=- pending=#1(netease:a) waiting=[#2(netease:b,ready)]
emit 1.7 queue pending=#1(netease:a) waiting=[#2(netease:b,ready)]
-- 07 --
> 4s prepared netease:a 2m
persist mode=sequential entrySeq=2 current=#1(netease:a,ready)@4.2s pending=- waiting=[#2(netease:b,ready)]
listen [m1] #1(netease:a,ready)@4.2s
emit 1.8 queue pending=- waiting=[#2(netease:b,ready)]
emit 1.9 playback #1(netease:a,ready)@4.2s
schedule 1 2m4.2s
-- 08 --
> 10s join s3 m2
listen [m2] #1(netease:a,ready)@4.2s
emit 1.10 members [s1=m1 s2=m1 s3=m2]
-- 09 --
> 11s join s4 m2
emit 1.11 members [s1=m1 s2=m1 s3=m2 s4=m2]
-- 10 --
> 12s join s5 m3
listen [m3] #1(netease:a,ready)@4.2s
emit 1.12 members [s1=m1 s2=m1 s3=m2 s4=m2 s5=m3]
-- 11 --
> 13s join s6 m3
emit 1.13 members [s1=m1 s2=m1 s3=m2 s4=m2 s5=m3 s6=m3]
-- 12 --
> 14s leave s5
emit 1.14 members [s1=m1 s2=m1 s3=m2 s4=m2 s6=m3]
-- 13 --
> 15s leave s6
emit 1.15 members [s1=m1 s2=m1 s3=m2 s4=m2]
-- 14 --
> 16s join s7 m3
listen [m3] #1(netease:a,ready)@4.2s
emit 1.16 members [s1=m1 s2=m1 s3=m2 s4=m2 s7=m3]
-- 15 --
> 2m4.2s timer 1
persist mode=sequential entrySeq=2 current=#2(netease:b,ready)@2m4.4s pending=- waiting=[]
record #1(netease:a,ready) 4.2s-2m4.2s
listen [m1 m2 m3] #2(netease:b,ready)@2m4.4s
emit 1.17 queue pending=- waiting=[]
emit 1.18 playback #2(netease:b,ready)@2m4.4s
schedule 2 3m4.4s
recommend 3
-- 16 --
> 3m4.4s timer 2
persist mode=sequential entrySeq=2 current=- pending=- waiting=[]
record #2(netease:b,ready) 2m4.4s-3m4.4s
emit 1.19 playback -
