投票切歌：4 个会话需要 2 票，同一成员不能重复投票。
-- 01 --
> restore persistent
-- 02 --
> 0s join s1 m1
emit 1.1 members [s1=m1]
-- 03 --
> 0s join s2 m2
emit 1.2 members [s1=m1 s2=m2]
-- 04 --
> 0s join s3 m3
emit 1.3 members [s1=m1 s2=m2 s3=m3]
-- 05 --
> 0s join s4 m3
emit 1.4 members [s1=m1 s2=m2 s3=m3 s4=m3]
-- 06 --
> 1s enqueue m1 netease:a
persist mode=sequential entrySeq=1 current=- pending=#1(netease:a) waiting=[]
emit 1.5 activity added m1 #1(netease:a)
emit 1.6 queue pending=#1(netease:a) waiting=[]
reply q06 enqueued #1(netease:a)
prepare netease:a
-- 07 --
> 1s prepared netease:a 3m
persist mode=sequential entrySeq=1 current=#1(netease:a,ready)@1.2s pending=- waiting=[]
emit 1.7 queue pending=- waiting=[]
emit 1.8 playback #1(netease:a,ready)@1.2s
schedule 1 3m1.2s
-- 08 --
> 10s vote m1
emit 1.9 activity voted m1 #1(netease:a,ready) 1/2
reply q08 voted 1/2
-- 09 --
> 11s vote m1
reply q09 error conflict 你已经投过票了。
-- 10 --
> 12s vote m2
persist mode=sequential entrySeq=1 current=- pending=- waiting=[]
record #1(netease:a,ready) 1.2s-12s
emit 1.10 activity skipped m2 #1(netease:a,ready) 2/2
emit 1.11 playback -
reply q10 voted 2/2 skipped
