轮流播放：点赞数相同时先比轮次，各点歌人轮流。轮次在入队时定下：新歌排进最早还没放完的一轮，点歌人已有歌时排到他最后一首的下一轮，之后删除、出队都不改变其余歌的顺序。甲靠后的一首被点赞先放时，新来的丙仍排进第 0 轮；第 0 轮都放完后，甲再点歌从第 1 轮开始。
-- 01 --
> restore persistent
-- 02 --
> 0s mode m1 rotation
persist mode=rotation entrySeq=0 current=- pending=- waiting=[]
emit 1.1 mode rotation
reply q02 done
-- 03 --
> 0s enqueue m1 netease:a1
persist mode=rotation entrySeq=1 current=- pending=#1(netease:a1) waiting=[]
emit 1.2 activity added m1 #1(netease:a1)
emit 1.3 queue pending=#1(netease:a1) waiting=[]
reply q03 enqueued #1(netease:a1)
prepare netease:a1
-- 04 --
> 0s enqueue m1 netease:a2
persist mode=rotation entrySeq=2 current=- pending=#1(netease:a1) waiting=[#2(netease:a2,round=1)]
emit 1.4 activity added m1 #2(netease:a2,round=1)
emit 1.5 queue pending=#1(netease:a1) waiting=[#2(netease:a2,round=1)]
reply q04 enqueued #2(netease:a2,round=1)
prepare netease:a2
-- 05 --
> 0s enqueue m2 netease:b1
persist mode=rotation entrySeq=3 current=- pending=#1(netease:a1) waiting=[#3(netease:b1) #2(netease:a2,round=1)]
emit 1.6 activity added m2 #3(netease:b1)
emit 1.7 queue pending=#1(netease:a1) waiting=[#3(netease:b1) #2(netease:a2,round=1)]
reply q05 enqueued #3(netease:b1)
prepare netease:b1
-- 06 --
> 0s enqueue m2 netease:b2
persist mode=rotation entrySeq=4 current=- pending=#1(netease:a1) waiting=[#3(netease:b1) #2(netease:a2,round=1) #4(netease:b2,round=1)]
emit 1.8 activity added m2 #4(netease:b2,round=1)
emit 1.9 queue pending=#1(netease:a1) waiting=[#3(netease:b1) #2(netease:a2,round=1) #4(netease:b2,round=1)]
reply q06 enqueued #4(netease:b2,round=1)
prepare netease:b2
-- 07 --
> 1s prepared netease:a1 1m
persist mode=rotation entrySeq=4 current=#1(netease:a1,ready)@1.2s pending=- waiting=[#3(netease:b1) #2(netease:a2,round=1) #4(netease:b2,round=1)]
emit 1.10 queue pending=- waiting=[#3(netease:b1) #2(netease:a2,round=1) #4(netease:b2,round=1)]
emit 1.11 playback #1(netease:a1,ready)@1.2s
schedule 1 1m1.2s
-- 08 --
> 2s enqueue m1 netease:a3
persist mode=rotation entrySeq=5 current=#1(netease:a1,ready)@1.2s pending=- waiting=[#3(netease:b1) #2(netease:a2,round=1) #4(netease:b2,round=1) #5(netease:a3,round=2)]
emit 1.12 activity added m1 #5(netease:a3,round=2)
emit 1.13 queue pending=- waiting=[#3(netease:b1) #2(netease:a2,round=1) #4(netease:b2,round=1) #5(netease:a3,round=2)]
reply q08 enqueued #5(netease:a3,round=2)
prepare netease:a3
-- 09 --
> 3s like m3 5
persist mode=rotation entrySeq=5 current=#1(netease:a1,ready)@1.2s pending=- waiting=[#5(netease:a3,likes=1,round=2) #3(netease:b1) #2(netease:a2,round=1) #4(netease:b2,round=1)]
emit 1.14 activity liked m3 #5(netease:a3,likes=1,round=2)
emit 1.15 queue pending=- waiting=[#5(netease:a3,likes=1,round=2) #3(netease:b1) #2(netease:a2,round=1) #4(netease:b2,round=1)]
reply q09 liked 1
-- 10 --
> 1m1.2s timer 1
persist mode=rotation entrySeq=5 current=- pending=#5(netease:a3,likes=1,round=2) waiting=[#3(netease:b1) #2(netease:a2,round=1) #4(netease:b2,round=1)]
record #1(netease:a1,ready) 1.2s-1m1.2s
emit 1.16 queue pending=#5(netease:a3,likes=1,round=2) waiting=[#3(netease:b1) #2(netease:a2,round=1) #4(netease:b2,round=1)]
emit 1.17 playback -
-- 11 --
> 1m2s enqueue m3 netease:c1
persist mode=rotation entrySeq=6 current=- pending=#5(netease:a3,likes=1,round=2) waiting=[#3(netease:b1) #6(netease:c1) #2(netease:a2,round=1) #4(netease:b2,round=1)]
emit 1.18 activity added m3 #6(netease:c1)
emit 1.19 queue pending=#5(netease:a3,likes=1,round=2) waiting=[#3(netease:b1) #6(netease:c1) #2(netease:a2,round=1) #4(netease:b2,round=1)]
reply q11 enqueued #6(netease:c1)
prepare netease:c1
-- 12 --
> 1m2s enqueue m3 netease:c2
persist mode=rotation entrySeq=7 current=- pending=#5(netease:a3,likes=1,round=2) waiting=[#3(netease:b1) #6(netease:c1) #2(netease:a2,round=1) #4(netease:b2,round=1) #7(netease:c2,round=1)]
emit 1.20 activity added m3 #7(netease:c2,round=1)
emit 1.21 queue pending=#5(netease:a3,likes=1,round=2) waiting=[#3(netease:b1) #6(netease:c1) #2(netease:a2,round=1) #4(netease:b2,round=1) #7(netease:c2,round=1)]
reply q12 enqueued #7(netease:c2,round=1)
prepare netease:c2
-- 13 --
> 1m3s remove m1 2
persist mode=rotation entrySeq=7 current=- pending=#5(netease:a3,likes=1,round=2) waiting=[#3(netease:b1) #6(netease:c1) #4(netease:b2,round=1) #7(netease:c2,round=1)]
emit 1.22 activity removed m1 #2(netease:a2,round=1)
emit 1.23 queue pending=#5(netease:a3,likes=1,round=2) waiting=[#3(netease:b1) #6(netease:c1) #4(netease:b2,round=1) #7(netease:c2,round=1)]
reply q13 done
-- 14 --
> 1m4s failed netease:a3 没有版权
persist mode=rotation entrySeq=7 current=- pending=#3(netease:b1) waiting=[#6(netease:c1) #4(netease:b2,round=1) #7(netease:c2,round=1)]
emit 1.24 activity failed - #5(netease:a3,likes=1,round=2) 没有版权
emit 1.25 queue pending=#3(netease:b1) waiting=[#6(netease:c1) #4(netease:b2,round=1) #7(netease:c2,round=1)]
-- 15 --
> 1m4s failed netease:b1 没有版权
persist mode=rotation entrySeq=7 current=- pending=#6(netease:c1) waiting=[#4(netease:b2,round=1) #7(netease:c2,round=1)]
emit 1.26 activity failed - #3(netease:b1) 没有版权
emit 1.27 queue pending=#6(netease:c1) waiting=[#4(netease:b2,round=1) #7(netease:c2,round=1)]
-- 16 --
> 1m4s failed netease:c1 没有版权
persist mode=rotation entrySeq=7 current=- pending=#4(netease:b2,round=1) waiting=[#7(netease:c2,round=1)]
emit 1.28 activity failed - #6(netease:c1) 没有版权
emit 1.29 queue pending=#4(netease:b2,round=1) waiting=[#7(netease:c2,round=1)]
-- 17 --
> 1m5s enqueue m1 netease:a4
persist mode=rotation entrySeq=8 current=- pending=#4(netease:b2,round=1) waiting=[#7(netease:c2,round=1) #8(netease:a4,round=1)]
emit 1.30 activity added m1 #8(netease:a4,round=1)
emit 1.31 queue pending=#4(netease:b2,round=1) waiting=[#7(netease:c2,round=1) #8(netease:a4,round=1)]
reply q17 enqueued #8(netease:a4,round=1)
prepare netease:a4
