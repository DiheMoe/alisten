POST /api/me/playlist-links
Authorization: Bearer $alice

{"link": "https://music.163.com/#/playlist?id=3778678"}
-- response --
200
{"source": "netease", "playlistId": "3778678"}

-- request --
POST /api/me/playlist-links
Authorization: Bearer $alice

{"link": "https://example.com/playlist?id=1"}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "不是网易云或 QQ 音乐的歌单链接"}}

-- request --
POST /api/me/playlists/platform-imports
Authorization: Bearer $alice

{"name": "周杰伦精选", "source": "netease", "playlistId": "3778678"}
-- response --
201
{"playlist": {"id": "$platform", "name": "周杰伦精选", "favorites": false, "trackCount": 2, "createdAtMs": 1, "updatedAtMs": 1, "coverUrl": "https://p1.music.126.net/example.jpg", "shareId": null}, "imported": 2}

-- request --
POST /api/me/playlists/platform-imports
Authorization: Bearer $alice

{"name": "QQ", "source": "qq", "playlistId": "1"}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "暂时只能导入网易云的歌单"}}
