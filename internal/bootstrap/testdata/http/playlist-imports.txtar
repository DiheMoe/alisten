歌单导入：只有已注册的账号能导入。导入文件时，曲目表里已有的歌用服务端的元数据，没有的用文件里的元数据。文件里的封面和页面链接不是平台自己的 https 地址时被丢弃，链接曲目没有封面。重复的歌只留第一次出现的位置，标题为空的跳过，来源中的第一首排在歌单最前。链接可以识别出平台歌单，目前只能导入网易云的歌单。

-- request --
POST /api/members

{}
-- response --
201
{"memberToken": "$alice", "member": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}}

-- request --
POST /api/me/playlists/imports
Authorization: Bearer $alice

{"name": "游客", "tracks": []}
-- response --
403
{"error": {"code": "FORBIDDEN", "message": "注册账号之后才能使用歌单"}}

-- request --
POST /api/me/playlist-links
Authorization: Bearer $alice

{"link": "https://music.163.com/#/playlist?id=3778678"}
-- response --
403
{"error": {"code": "FORBIDDEN", "message": "注册账号之后才能使用歌单"}}

-- request --
POST /api/me/playlists/platform-imports
Authorization: Bearer $alice

{"name": "游客", "source": "netease", "playlistId": "3778678"}
-- response --
403
{"error": {"code": "FORBIDDEN", "message": "注册账号之后才能使用歌单"}}

-- request --
POST /api/account
Authorization: Bearer $alice

{"username": "alice", "password": "correct horse"}
-- response --
201
{"account": {"username": "alice", "github": false}}

-- request --
POST /api/rooms

{"name": "临时", "description": ""}
-- response --
201
Location: /api/rooms/$room
{"id": "$room"}

-- request --
POST /api/rooms/$room/tickets
Authorization: Bearer $alice

{}
-- response --
201
{"ticket": "$ticket"}

-- stream alice --
Authorization: Bearer $ticket
-- event alice --
event: snapshot
data: {"room": {"term": 1, "seq": 0, "room": {"id": "$room", "name": "临时", "description": "", "kind": "ephemeral"},
  "playMode": "sequential", "nowPlaying": null, "pending": null, "items": [],
  "members": {"sessions": [], "onlineCount": 0}}}

-- request --
POST /api/room/queue
Authorization: Bearer $ticket

{"track": {"source": "netease", "id": "186016"}}
-- response --
201
Location: /api/room/queue/1
{"entry": {"id": "1", "track": {"source": "netease", "id": "186016"},
  "meta": {"title": "晴天", "artist": "周杰伦", "album": "叶惠美", "coverUrl": "https://p1.music.126.net/example.jpg", "pageUrl": "https://music.163.com/#/song?id=186016", "durationMs": 269000},
  "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "preparing"}}
-- event alice --
event: room.activity
id: 1
data: {"kind": "event", "type": "room.activity", "term": 1, "seq": 1, "data": {"kind": "added", "member": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""},
  "entry": {"id": "1", "track": {"source": "netease", "id": "186016"}, "meta": {"title": "晴天", "artist": "周杰伦", "album": "叶惠美", "coverUrl": "https://p1.music.126.net/example.jpg", "pageUrl": "https://music.163.com/#/song?id=186016", "durationMs": 269000},
    "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "preparing"},
  "message": "点了《晴天》"}}
-- event alice --
event: queue.updated
id: 2
data: {"kind": "event", "type": "queue.updated", "term": 1, "seq": 2, "data": {"items": [],
  "pending": {"id": "1", "track": {"source": "netease", "id": "186016"}, "meta": {"title": "晴天", "artist": "周杰伦", "album": "叶惠美", "coverUrl": "https://p1.music.126.net/example.jpg", "pageUrl": "https://music.163.com/#/song?id=186016", "durationMs": 269000},
    "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "preparing"}}}
-- event alice --
event: queue.updated
id: 3
data: {"kind": "event", "type": "queue.updated", "term": 1, "seq": 3, "data": {"pending": null, "items": []}}
-- event alice --
event: playback.updated
id: 4
data: {"kind": "event", "type": "playback.updated", "term": 1, "seq": 4, "data": {"nowPlaying": {
  "entry": {"id": "1", "track": {"source": "netease", "id": "186016"}, "meta": {"title": "晴天", "artist": "周杰伦", "album": "叶惠美", "coverUrl": "https://p1.music.126.net/example.jpg", "pageUrl": "https://music.163.com/#/song?id=186016", "durationMs": 269500},
    "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "ready"},
  "mediaUrl": "/media/netease/186016", "startedAtMs": 1, "durationMs": 269500, "gain": 1, "lyric": "[00:01.00]故事的小黄花"}}}

-- request --
POST /api/me/playlists/imports
Authorization: Bearer $alice

{"name": "  文件里的歌单  ", "tracks": [
  {"track": {"source": "netease", "id": "186016"}, "title": "改过的标题", "artist": "改过的歌手", "durationMs": 1000, "coverUrl": "https://evil.example/c.jpg"},
  {"track": {"source": "netease", "id": "999"}, "title": "文件里的歌", "artist": "歌手", "album": "专辑", "durationMs": 61000, "coverUrl": "http://p1.music.126.net/a.jpg", "pageUrl": "https://evil.example/song"},
  {"track": {"source": "link", "id": "https://example.com/song.mp3"}, "title": "链接曲目", "durationMs": 5000, "coverUrl": "https://p1.music.126.net/b.jpg"},
  {"track": {"source": "netease", "id": "186016"}, "title": "重复", "durationMs": 1},
  {"track": {"source": "netease", "id": "1000"}, "title": "  ", "durationMs": 1}
]}
-- response --
201
{"playlist": {"id": "$imported", "name": "文件里的歌单", "favorites": false, "trackCount": 3, "createdAtMs": 1, "updatedAtMs": 1, "coverUrl": "https://p1.music.126.net/example.jpg", "shareId": null}, "imported": 3}

-- request --
GET /api/me/playlists/$imported/items
Authorization: Bearer $alice
