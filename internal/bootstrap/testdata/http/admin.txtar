POST /api/admin/credentials/netease/qr-logins/status
Authorization: Bearer admin-secret

{"key": ""}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "key：长度不能少于 1 个字符"}}

-- request --
POST /api/admin/credentials/qq/qr-logins
Authorization: Bearer admin-secret

{"type": "qq"}
-- response --
201
{"key": "$qqKey", "qrImage": "data:image/png;base64,iVBORw0KGgo=", "expiresAtMs": 1}

