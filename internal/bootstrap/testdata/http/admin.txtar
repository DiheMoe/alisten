POST /api/admin/credentials/qq/qr-logins
Authorization: Bearer admin-secret

{"type": "wechat"}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "type：取值应为 qq、wx 之一"}}

-- request --
POST /api/admin/credentials/qq/qr-logins/status
Authorization: Bearer admin-secret

{"type": "wx", "key": "$wxKey"}
-- response --
200
{"status": "waiting", "message": ""}

-- request --
POST /api/admin/credentials/qq/qr-logins/status
Authorization: Bearer admin-secret

{"type": "qq", "key": "$wxKey"}
-- response --
200
{"status": "expired", "message": ""}

