Authorization: Bearer admin-secret
-- response --
200
{"set": false, "account": null}

-- request --
PUT /api/admin/credentials/netease
Authorization: Bearer admin-secret

{}
-- response --
404
{"error": {"code": "NOT_FOUND", "message": "接口不存在"}}

-- request --
POST /api/admin/credentials/netease/qr-logins
Authorization: Bearer admin-secret

{}
-- response --
201
{"key": "$neteaseKey", "qrImage": "$neteaseImage", "expiresAtMs": 1}

-- request --
POST /api/admin/credentials/netease/qr-logins/status
Authorization: Bearer admin-secret

{"key": "$neteaseKey"}
-- response --
200
{"status": "waiting", "message": ""}

