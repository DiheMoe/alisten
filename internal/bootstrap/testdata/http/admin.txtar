后台：常驻房间的列表和新建、按别名查找房间、音源账号的登录状态和扫码登录（包括 B 站）、YouTube cookies 的填写、清除和状态（不返回内容，空的 cookies 不能填写）、已存储的媒体。

-- request --
GET /api/admin/rooms
-- response --
401
{"error": {"code": "UNAUTHORIZED", "message": "管理 token 无效"}}

-- request --
GET /api/admin/rooms
Authorization: Bearer wrong-token
-- response --
401
{"error": {"code": "UNAUTHORIZED", "message": "管理 token 无效"}}

-- request --
GET /api/admin/rooms
Authorization: Bearer admin-secret
-- response --
200
{"items": []}

-- request --
POST /api/admin/rooms
Authorization: Bearer admin-secret

{"name": "大厅", "description": "常驻", "slug": "hall", "password": "芝麻开门"}
-- response --
201
Location: /api/rooms/$hall
{"id": "$hall"}

-- request --
POST /api/admin/rooms
Authorization: Bearer admin-secret

{"name": "二厅", "description": ""}
-- response --
201
Location: /api/rooms/$second
{"id": "$second"}

-- request --
POST /api/admin/rooms
Authorization: Bearer admin-secret

{"name": "三厅", "description": "", "slug": "hall"}
-- response --
409
{"error": {"code": "CONFLICT", "message": "别名已被占用"}}

-- request --
POST /api/admin/rooms
Authorization: Bearer admin-secret

{"name": "三厅", "description": "", "slug": "Hall"}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "slug：格式不正确"}}

-- request --
POST /api/rooms

{"name": "临时", "description": ""}
-- response --
201
Location: /api/rooms/$open
{"id": "$open"}

-- request --
GET /api/admin/rooms
Authorization: Bearer admin-secret
-- response --
200
{"items": [
  {"id": "$hall", "slug": "hall", "name": "大厅", "description": "常驻", "kind": "persistent", "hasPassword": true, "onlineCount": 0},
  {"id": "$second", "slug": null, "name": "二厅", "description": "", "kind": "persistent", "hasPassword": false, "onlineCount": 0}
]}

-- request --
GET /api/rooms
-- response --
200
{"items": [
  {"id": "$hall", "slug": "hall", "name": "大厅", "description": "常驻", "kind": "persistent", "hasPassword": true, "onlineCount": 0},
  {"id": "$second", "slug": null, "name": "二厅", "description": "", "kind": "persistent", "hasPassword": false, "onlineCount": 0},
  {"id": "$open", "slug": null, "name": "临时", "description": "", "kind": "ephemeral", "hasPassword": false, "onlineCount": 0}
]}

-- request --
GET /api/rooms/hall
-- response --
200
{"id": "$hall", "slug": "hall", "name": "大厅", "description": "常驻", "kind": "persistent", "hasPassword": true, "onlineCount": 0}

-- request --
GET /api/rooms/HALL
-- response --
404
{"error": {"code": "NOT_FOUND", "message": "房间不存在"}}

-- request --
POST /api/members

{}
-- response --
201
{"memberToken": "$alice", "member": {"id": "$aliceId", "name": "$guestName", "avatarHash": ""}}

