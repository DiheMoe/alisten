站点：品牌名默认是 Alisten，默认开放注册；后台修改品牌名时返回存下的名字，首尾的空白已经去掉，之后读到的也是它；空的、超过 20 个字符的和看不见的名字不能保存；后台可以关闭和重新开放注册，关闭之后游客不能注册；修改站点设置要管理 token。

-- request --
GET /api/site
-- response --
200
{"brandName": "Alisten", "registrationOpen": true}

-- request --
PATCH /api/admin/site
Authorization: Bearer admin-secret

{"brandName": "  周末听歌会  "}
-- response --
200
{"brandName": "周末听歌会"}

-- request --
GET /api/site
-- response --
200
{"brandName": "周末听歌会", "registrationOpen": true}

-- request --
PATCH /api/admin/site
Authorization: Bearer admin-secret

{"brandName": ""}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "brandName：去掉首尾空白后应有 1 到 20 个字符，其中至少一个看得见，不能包含控制字符"}}

-- request --
PATCH /api/admin/site
Authorization: Bearer admin-secret

{"brandName": "一二三四五六七八九十一二三四五六七八九十一"}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "brandName：去掉首尾空白后应有 1 到 20 个字符，其中至少一个看得见，不能包含控制字符"}}

-- request --
PATCH /api/admin/site
Authorization: Bearer admin-secret

{"brandName": "\u200b\u3000\u200b"}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "brandName：去掉首尾空白后应有 1 到 20 个字符，其中至少一个看得见，不能包含控制字符"}}

-- request --
PATCH /api/admin/site

{"brandName": "别人的名字"}
-- response --
401
{"error": {"code": "UNAUTHORIZED", "message": "管理 token 无效"}}

-- request --
DELETE /api/admin/registration
-- response --
401
{"error": {"code": "UNAUTHORIZED", "message": "管理 token 无效"}}

-- request --
DELETE /api/admin/registration
Authorization: Bearer admin-secret
-- response --
204

-- request --
GET /api/site
-- response --
200
{"brandName": "周末听歌会", "registrationOpen": false}

-- request --
POST /api/members

{}
-- response --
201
{"memberToken": "$guest", "member": {"id": "$guestId", "name": "$guestName", "avatarHash": ""}}

-- request --
POST /api/account
Authorization: Bearer $guest

{"username": "guest", "password": "correct horse"}
-- response --
403
{"error": {"code": "FORBIDDEN", "message": "注册已关闭"}}

-- request --
PUT /api/admin/registration
Authorization: Bearer admin-secret

{}
-- response --
204

-- request --
POST /api/account
Authorization: Bearer $guest

{"username": "guest", "password": "correct horse"}
-- response --
201
{"account": {"username": "guest"}}
