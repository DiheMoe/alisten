大厅：房间列表、按 UUID 查找房间、创建临时房间。

-- request --
GET /api/rooms
-- response --
200
{"items": []}

-- request --
POST /api/rooms

{"name": "临时", "description": "随便听听"}
-- response --
201
Location: /api/rooms/$open
{"id": "$open"}

-- request --
POST /api/rooms

{"name": "上锁", "description": "", "password": "芝麻开门"}
-- response --
201
Location: /api/rooms/$locked
{"id": "$locked"}

-- request --
GET /api/rooms
-- response --
200
{"items": [
  {"id": "$open", "slug": null, "name": "临时", "description": "随便听听", "kind": "ephemeral", "hasPassword": false, "onlineCount": 0},
  {"id": "$locked", "slug": null, "name": "上锁", "description": "", "kind": "ephemeral", "hasPassword": true, "onlineCount": 0}
]}

-- request --
GET /api/rooms/$locked
-- response --
200
{"id": "$locked", "slug": null, "name": "上锁", "description": "", "kind": "ephemeral", "hasPassword": true, "onlineCount": 0}

-- request --
GET /api/rooms/01a15778-1911-7a28-8b2e-e08c2a25f388
-- response --
404
{"error": {"code": "NOT_FOUND", "message": "房间不存在"}}

-- request --
GET /api/rooms/no-such-room
-- response --
404
{"error": {"code": "NOT_FOUND", "message": "房间不存在"}}

-- request --
GET /api/rooms/%00
-- response --
404
{"error": {"code": "NOT_FOUND", "message": "房间不存在"}}

-- request --
GET /api/rooms/hall%00
-- response --
404
{"error": {"code": "NOT_FOUND", "message": "房间不存在"}}

-- request --
POST /api/rooms

{"name": "", "description": ""}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "name：长度不能少于 1 个字符"}}

-- request --
POST /api/rooms

{"name": "临时", "description": "\u0000"}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "description：不能包含 U+0000"}}

-- request --
POST /api/rooms

{"name": "临时", "description": "", "slug": "lobby"}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "slug：未知字段"}}
