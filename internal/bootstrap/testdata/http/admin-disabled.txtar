没有配置管理 token 时，管理接口一律返回 FORBIDDEN，不看凭证和请求体。

-- env --
ALISTEN_ADMIN_TOKEN=

-- request --
GET /api/admin/rooms
Authorization: Bearer admin-secret
-- response --
403
{"error": {"code": "FORBIDDEN", "message": "后台没有启用：服务端没有配置管理 token。"}}

-- request --
POST /api/admin/rooms

不是 JSON
-- response --
403
{"error": {"code": "FORBIDDEN", "message": "后台没有启用：服务端没有配置管理 token。"}}

-- request --
GET /api/admin/rooms/01a15778-1911-7a28-8b2e-e08c2a25f388/api-key
Authorization: Bearer admin-secret
-- response --
403
{"error": {"code": "FORBIDDEN", "message": "后台没有启用：服务端没有配置管理 token。"}}

