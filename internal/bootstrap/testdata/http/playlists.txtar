歌单：只有已注册的账号能使用；注册时自带不能重命名、不能删除的“我喜欢”；收藏时元数据由服务端查询，同一首歌只收一次，新加入的在前；可以批量移出、复制到别的歌单、调整顺序；别人的歌单和不存在的一样。

-- request --
POST /api/members

{}
-- response --
201
{"memberToken": "$alice", "member": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}}

-- request --
GET /api/me/playlists
Authorization: Bearer $alice
-- response --
403
{"error": {"code": "FORBIDDEN", "message": "注册账号之后才能使用歌单"}}

-- request --
POST /api/me/playlists
Authorization: Bearer $alice

{"name": "通勤"}
-- response --
403
{"error": {"code": "FORBIDDEN", "message": "注册账号之后才能使用歌单"}}

-- request --
POST /api/account
Authorization: Bearer $alice

{"username": "alice", "password": "correct horse"}
-- response --
201
{"account": {"username": "alice"}}

-- request --
GET /api/me/playlists
Authorization: Bearer $alice
-- response --
200
{"items": [{"id": "$favorites", "name": "我喜欢", "favorites": true, "trackCount": 0, "createdAtMs": 1, "updatedAtMs": 1, "coverUrl": null}]}

-- request --
POST /api/me/playlists/$favorites/items
Authorization: Bearer $alice

{"track": {"source": "netease", "id": "186016"}}
-- response --
201
{"item": {"track": {"source": "netease", "id": "186016"}, "meta": {"title": "晴天", "artist": "周杰伦", "album": "叶惠美", "coverUrl": "https://p1.music.126.net/example.jpg", "pageUrl": "https://music.163.com/#/song?id=186016", "durationMs": 269000}}}

-- request --
POST /api/me/playlists/$favorites/items
Authorization: Bearer $alice

{"track": {"source": "netease", "id": "186016"}}
-- response --
201
{"item": {"track": {"source": "netease", "id": "186016"}, "meta": {"title": "晴天", "artist": "周杰伦", "album": "叶惠美", "coverUrl": "https://p1.music.126.net/example.jpg", "pageUrl": "https://music.163.com/#/song?id=186016", "durationMs": 269000}}}

-- request --
POST /api/me/playlists/$favorites/items
Authorization: Bearer $alice

{"track": {"source": "netease", "id": "185811"}}
-- response --
201
{"item": {"track": {"source": "netease", "id": "185811"}, "meta": {"title": "七里香", "artist": "周杰伦", "album": "七里香", "coverUrl": "https://p1.music.126.net/qilixiang.jpg", "pageUrl": "https://music.163.com/#/song?id=185811", "durationMs": 299000}}}

-- request --
GET /api/me/playlists/$favorites/items
Authorization: Bearer $alice
-- response --
200
{"items": [
  {"track": {"source": "netease", "id": "185811"}, "meta": {"title": "七里香", "artist": "周杰伦", "album": "七里香", "coverUrl": "https://p1.music.126.net/qilixiang.jpg", "pageUrl": "https://music.163.com/#/song?id=185811", "durationMs": 299000}},
  {"track": {"source": "netease", "id": "186016"}, "meta": {"title": "晴天", "artist": "周杰伦", "album": "叶惠美", "coverUrl": "https://p1.music.126.net/example.jpg", "pageUrl": "https://music.163.com/#/song?id=186016", "durationMs": 269000}}
]}

-- request --
POST /api/me/playlists/$favorites/items
Authorization: Bearer $alice

{"track": {"source": "link", "id": "https://example.com/song.mp3"}}
-- response --
409
{"error": {"code": "CONFLICT", "message": "这首歌还在准备，准备好之后再保存"}}

-- request --
POST /api/me/playlists
Authorization: Bearer $alice

{"name": "  通勤  "}
-- response --
201
{"id": "$commute", "name": "通勤", "favorites": false, "trackCount": 0, "createdAtMs": 1, "updatedAtMs": 1, "coverUrl": null}

-- request --
POST /api/me/playlists
Authorization: Bearer $alice

{"name": "   "}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "name：去掉首尾空白后应有 1 到 50 个字符，其中至少一个看得见，不能包含控制字符"}}

-- request --
PATCH /api/me/playlists/$commute
Authorization: Bearer $alice

{"name": "上班路上"}
-- response --
204

-- request --
PATCH /api/me/playlists/$favorites
Authorization: Bearer $alice

{"name": "别的名字"}
-- response --
409
{"error": {"code": "CONFLICT", "message": "“我喜欢”不能重命名或删除"}}

-- request --
DELETE /api/me/playlists/$favorites
Authorization: Bearer $alice
-- response --
409
{"error": {"code": "CONFLICT", "message": "“我喜欢”不能重命名或删除"}}

-- request --
POST /api/me/playlists/$commute/copies
Authorization: Bearer $alice

{"from": "$favorites", "tracks": [{"source": "netease", "id": "186016"}, {"source": "netease", "id": "185811"}, {"source": "netease", "id": "999"}, {"source": "netease", "id": "186016"}]}
-- response --
200
{"added": 2}

-- request --
POST /api/me/playlists/$commute/copies
Authorization: Bearer $alice

{"from": "$favorites", "tracks": [{"source": "netease", "id": "185811"}]}
-- response --
200
{"added": 0}

-- request --
GET /api/me/playlists/$commute/items
Authorization: Bearer $alice
-- response --
200
{"items": [
  {"track": {"source": "netease", "id": "186016"}, "meta": {"title": "晴天", "artist": "周杰伦", "album": "叶惠美", "coverUrl": "https://p1.music.126.net/example.jpg", "pageUrl": "https://music.163.com/#/song?id=186016", "durationMs": 269000}},
  {"track": {"source": "netease", "id": "185811"}, "meta": {"title": "七里香", "artist": "周杰伦", "album": "七里香", "coverUrl": "https://p1.music.126.net/qilixiang.jpg", "pageUrl": "https://music.163.com/#/song?id=185811", "durationMs": 299000}}
]}

-- request --
POST /api/me/playlists/$commute/moves
Authorization: Bearer $alice

{"tracks": [{"source": "netease", "id": "186016"}]}
-- response --
204

-- request --
GET /api/me/playlists/$commute/items
Authorization: Bearer $alice
-- response --
200
{"items": [
  {"track": {"source": "netease", "id": "185811"}, "meta": {"title": "七里香", "artist": "周杰伦", "album": "七里香", "coverUrl": "https://p1.music.126.net/qilixiang.jpg", "pageUrl": "https://music.163.com/#/song?id=185811", "durationMs": 299000}},
  {"track": {"source": "netease", "id": "186016"}, "meta": {"title": "晴天", "artist": "周杰伦", "album": "叶惠美", "coverUrl": "https://p1.music.126.net/example.jpg", "pageUrl": "https://music.163.com/#/song?id=186016", "durationMs": 269000}}
]}

-- request --
POST /api/me/playlists/$commute/moves
Authorization: Bearer $alice

{"tracks": [{"source": "netease", "id": "186016"}], "before": {"source": "netease", "id": "185811"}}
-- response --
204

-- request --
GET /api/me/playlists/$commute/items
Authorization: Bearer $alice
-- response --
200
{"items": [
  {"track": {"source": "netease", "id": "186016"}, "meta": {"title": "晴天", "artist": "周杰伦", "album": "叶惠美", "coverUrl": "https://p1.music.126.net/example.jpg", "pageUrl": "https://music.163.com/#/song?id=186016", "durationMs": 269000}},
  {"track": {"source": "netease", "id": "185811"}, "meta": {"title": "七里香", "artist": "周杰伦", "album": "七里香", "coverUrl": "https://p1.music.126.net/qilixiang.jpg", "pageUrl": "https://music.163.com/#/song?id=185811", "durationMs": 299000}}
]}

-- request --
POST /api/me/playlists/$commute/moves
Authorization: Bearer $alice

{"tracks": [{"source": "netease", "id": "186016"}], "before": {"source": "netease", "id": "999"}}
-- response --
409
{"error": {"code": "CONFLICT", "message": "歌单已经变了，刷新之后再试"}}

-- request --
POST /api/me/playlists/$commute/moves
Authorization: Bearer $alice

{"tracks": [{"source": "netease", "id": "186016"}], "before": {"source": "netease", "id": "186016"}}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "before 不能是要移动的歌"}}

-- request --
POST /api/me/playlists/$commute/moves
Authorization: Bearer $alice

{"tracks": []}
-- response --
400
{"error": {"code": "INVALID_ARGUMENT", "message": "tracks：元素不能少于 1 个"}}

-- request --
GET /api/me/playlists
Authorization: Bearer $alice
-- response --
200
{"items": [{"id": "$favorites", "name": "我喜欢", "favorites": true, "trackCount": 2, "createdAtMs": 1, "updatedAtMs": 1, "coverUrl": "https://p1.music.126.net/qilixiang.jpg"}, {"id": "$commute", "name": "上班路上", "favorites": false, "trackCount": 2, "createdAtMs": 1, "updatedAtMs": 1, "coverUrl": "https://p1.music.126.net/example.jpg"}]}

-- request --
POST /api/me/playlist-memberships
Authorization: Bearer $alice

{"track": {"source": "netease", "id": "186016"}}
-- response --
200
{"playlistIds": ["$favorites", "$commute"]}

-- request --
POST /api/me/playlist-memberships
