音源拒绝的歌准备失败：条目移出队列，房间广播失败的原因，不再重试。

-- request --
POST /api/members

{}
-- response --
201
{"memberToken": "$alice", "member": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}}

-- request --
POST /api/admin/rooms
Authorization: Bearer admin-secret

{"name": "大厅", "description": ""}
-- response --
201
Location: /api/rooms/$room
{"id": "$room"}

-- request --
POST /api/rooms/$room/tickets
Authorization: Bearer $alice

{}
-- response --
201
{"ticket": "$ticket"}

-- connect alice --
-- send alice --
{"kind": "request", "type": "hello", "id": "h1", "data": {"roomId": "$room", "ticket": "$ticket", "protocolVersion": "$protocolVersion"}}
-- receive alice --
{"kind": "response", "type": "hello", "id": "h1", "data": {
  "member": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""},
  "serverTimeMs": 1,
  "room": {"term": 1, "seq": 1, "room": {"id": "$room", "name": "大厅", "description": "", "kind": "persistent"},
    "playMode": "sequential", "nowPlaying": null, "pending": null, "items": [],
    "members": {"sessions": [{"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}], "onlineCount": 1}}}}

-- send alice --
{"kind": "request", "type": "queue.add", "id": "a1", "data": {"track": {"source": "netease", "id": "404"}}}
-- receive alice --
{"kind": "event", "type": "room.activity", "term": 1, "seq": 2, "data": {"kind": "added", "member": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""},
  "entry": {"id": "1", "track": {"source": "netease", "id": "404"}, "meta": {"title": "不能播放的歌", "artist": "无名", "album": "", "coverUrl": "", "pageUrl": "https://music.163.com/#/song?id=404", "durationMs": 60000},
    "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "preparing"},
  "message": "点了《不能播放的歌》"}}
-- receive alice --
{"kind": "event", "type": "queue.updated", "term": 1, "seq": 3, "data": {"items": [],
  "pending": {"id": "1", "track": {"source": "netease", "id": "404"}, "meta": {"title": "不能播放的歌", "artist": "无名", "album": "", "coverUrl": "", "pageUrl": "https://music.163.com/#/song?id=404", "durationMs": 60000},
    "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "preparing"}}}
-- receive alice --
{"kind": "response", "type": "queue.add", "id": "a1", "data": {"entry": {"id": "1", "track": {"source": "netease", "id": "404"},
  "meta": {"title": "不能播放的歌", "artist": "无名", "album": "", "coverUrl": "", "pageUrl": "https://music.163.com/#/song?id=404", "durationMs": 60000},
  "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "preparing"}}}
-- receive alice --
{"kind": "event", "type": "room.activity", "term": 1, "seq": 4, "data": {"kind": "failed",
  "entry": {"id": "1", "track": {"source": "netease", "id": "404"}, "meta": {"title": "不能播放的歌", "artist": "无名", "album": "", "coverUrl": "", "pageUrl": "https://music.163.com/#/song?id=404", "durationMs": 60000},
    "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "preparing"},
  "message": "《不能播放的歌》没能准备好：网易云没有提供这首歌的播放地址"}}
-- receive alice --
{"kind": "event", "type": "queue.updated", "term": 1, "seq": 5, "data": {"pending": null, "items": []}}
