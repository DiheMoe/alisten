B 站：临时房间可以点 B 站的视频，完整链接和 b23.tv 短链识别成同一首；认得出但不能点的链接（番剧）返回音源给出的原因；
直接给出的曲目 ID 格式不对时返回 INVALID_ARGUMENT。没有 worker，点到的歌一直在准备中。

-- request --
POST /api/members

{}
-- response --
201
{"memberToken": "$alice", "member": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}}

-- request --
POST /api/rooms

{"name": "临时", "description": ""}
-- response --
201
Location: /api/rooms/$room
{"id": "$room"}

-- request --
POST /api/rooms/$room/tickets
Authorization: Bearer $alice

{}
-- response --
201
{"ticket": "$ticket"}

-- connect alice --
-- send alice --
{"kind": "request", "type": "hello", "id": "h1", "data": {"roomId": "$room", "ticket": "$ticket", "protocolVersion": "$protocolVersion"}}
-- receive alice --
{"kind": "response", "type": "hello", "id": "h1", "data": {
  "member": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""},
  "serverTimeMs": 1,
  "room": {"term": 1, "seq": 1, "room": {"id": "$room", "name": "临时", "description": "", "kind": "ephemeral"},
    "playMode": "sequential", "nowPlaying": null, "pending": null, "items": [],
    "members": {"sessions": [{"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}], "onlineCount": 1}}}}

-- send alice --
{"kind": "request", "type": "queue.add", "id": "a1", "data": {"track": {"source": "link", "id": "https://www.bilibili.com/video/BV1xx411c7mD?p=2"}}}
-- receive alice --
{"kind": "event", "type": "room.activity", "term": 1, "seq": 2, "data": {"kind": "added", "member": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""},
  "entry": {"id": "1", "track": {"source": "bilibili", "id": "BV1xx411c7mD/2"}, "meta": {"title": "晴天（钢琴版）", "artist": "某 UP 主", "album": "", "coverUrl": "", "pageUrl": "https://www.bilibili.com/video/BV1xx411c7mD?p=2", "durationMs": 2000},
    "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "preparing"},
  "message": "点了《晴天（钢琴版）》"}}
-- receive alice --
{"kind": "event", "type": "queue.updated", "term": 1, "seq": 3, "data": {"items": [],
  "pending": {"id": "1", "track": {"source": "bilibili", "id": "BV1xx411c7mD/2"}, "meta": {"title": "晴天（钢琴版）", "artist": "某 UP 主", "album": "", "coverUrl": "", "pageUrl": "https://www.bilibili.com/video/BV1xx411c7mD?p=2", "durationMs": 2000},
    "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "preparing"}}}
-- receive alice --
{"kind": "response", "type": "queue.add", "id": "a1", "data": {"entry": {"id": "1", "track": {"source": "bilibili", "id": "BV1xx411c7mD/2"},
  "meta": {"title": "晴天（钢琴版）", "artist": "某 UP 主", "album": "", "coverUrl": "", "pageUrl": "https://www.bilibili.com/video/BV1xx411c7mD?p=2", "durationMs": 2000},
  "by": {"id": "$aliceId", "name": "$aliceName", "avatarHash": ""}, "auto": false, "likes": 0, "status": "preparing"}}}

-- send alice --
{"kind": "request", "type": "queue.add", "id": "a2", "data": {"track": {"source": "link", "id": "https://b23.tv/qingtian"}}}
-- receive alice --
{"kind": "response", "type": "queue.add", "id": "a2", "data": {}, "error": {"code": "CONFLICT", "message": "这首歌已经在播放列表里了。"}}
-- send alice --
{"kind": "request", "type": "queue.add", "id": "a3", "data": {"track": {"source": "link", "id": "https://www.bilibili.com/bangumi/play/ep1"}}}
-- receive alice --
{"kind": "response", "type": "queue.add", "id": "a3", "data": {}, "error": {"code": "INVALID_ARGUMENT", "message": "哔哩哔哩的番剧不能点播"}}
-- send alice --
{"kind": "request", "type": "queue.add", "id": "a4", "data": {"track": {"source": "bilibili", "id": "BV1xx411c7mD/1"}}}
-- receive alice --
{"kind": "response", "type": "queue.add", "id": "a4", "data": {}, "error": {"code": "INVALID_ARGUMENT", "message": "data.track.id：格式不正确"}}
-- send alice --
{"kind": "request", "type": "queue.add", "id": "a5", "data": {"track": {"source": "bilibili", "id": "BV1xx411c7mD/2"}}}
-- receive alice --
{"kind": "response", "type": "queue.add", "id": "a5", "data": {}, "error": {"code": "CONFLICT", "message": "这首歌已经在播放列表里了。"}}
