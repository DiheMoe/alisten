# serve 有两个副本，重启后地址会变，所以把主机名放在变量里，nginx 才会在每个请求时解析。这样启动时上游也不必已经存在。
resolver 127.0.0.11 valid=5s;
set $serve serve:8080;
set $rustfs rustfs:9000;
proxy_http_version 1.1;
absolute_redirect off;

# default.conf 里有一个正则 location 匹配以 / 结尾的路径。前缀 location 只有带上 ^~ 才能优先于这个正则 location。
location ^~ /api/ {
    # 缓冲区不小于 serve 的请求体上限，请求体就不会写进临时文件，nginx 也就不会因此输出纯文本的 warn 日志。
    client_body_buffer_size 64k;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_pass http://$serve;

    # 这两项取值不能小于 serve 给批量歌单接口定的请求体上限 maxBatchBodyBytes（2304000 字节）。否则大请求会被 nginx 用 HTML 的 413 拒绝，或者写进临时文件。
    location ~ ^/api/me/playlists/[^/]+/(removals|copies|moves)$ {
        client_max_body_size 2250k;
        client_body_buffer_size 2250k;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://$serve;
    }

    # 这两项取值不能小于 serve 给导入文件接口定的请求体上限 maxImportBodyBytes（1 MiB），原因同上。
    location = /api/me/playlists/imports {
        client_max_body_size 1m;
        client_body_buffer_size 1m;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://$serve;
    }
}
location ^~ /media/ {
    proxy_pass http://$serve;
}
# 空闲连接由 serve 断开，这里的超时只作兜底。
location = /ws {
    proxy_pass http://$serve;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}
# 只转发 link/ 下的读取请求，因为 RustFS 的其他接口也在同一个端口上。这些对象来自用户提交的链接，又和页面同源，所以靠末尾的两个响应头阻止其中的脚本运行。
# 用 return 而不用 limit_except，这样拒绝时不会写纯文本的错误日志。关闭缓冲，因为开着缓冲时，超出内存缓冲区的响应会写进 /tmp 的 tmpfs。
location ^~ /storage/${STORAGE_BUCKET_NAME}/link/ {
    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }
    rewrite ^/storage(/.*)$ $1 break;
    proxy_pass http://$rustfs;
    proxy_buffering off;
    add_header Content-Security-Policy "sandbox; default-src 'none'" always;
    add_header X-Content-Type-Options nosniff always;
}
